# Copiar a .env sólo para habilitar servicios opcionales. Nunca subir claves.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Vercel word translation is disabled until a real FREE F0 resource is verified.
AZURE_TRANSLATOR_TIER=F0
READLINGO_TRANSLATION_ENABLED=false
# Generate a separate random personal code (32+ characters). NEVER use the Azure key.
READLINGO_TRANSLATION_ACCESS_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
